# Upstash Redis REST credentials — wajib untuk konfigurasi persisten
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=isi_rest_token_upstash

# Buat dengan: openssl rand -hex 32 (64 karakter hex). Jangan diganti setelah data tersimpan.
WINE_PTERO_ENCRYPTION_KEY=isi_64_karakter_hex_dari_openssl_rand_hex_32

# Rahasia admin acak dan panjang; jangan masukkan ke frontend
WINE_PTERO_ADMIN_SECRET=buat-kunci-rahasia-panjang-acak

# IDs yang diperlukan untuk pembuatan server
PTERO_EGG_ID=15
PTERO_LOCATION_ID=1
PTERO_EMAIL_DOMAIN=gmail.com
# Opsional
PTERO_DOCKER_IMAGE=ghcr.io/parkervcp/yolks:nodejs_20
# PTERO_STARTUP=...

# Login Google (opsional). Client ID dari Google Cloud Console > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=isi_client_id_google.apps.googleusercontent.com

# Optional WINE AI provider (configure in Vercel Environment Variables, never in HTML)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
